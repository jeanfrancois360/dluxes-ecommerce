# ============================================================================
# NextPik Production Environment Variables
# Copy to .env and fill in real values before deploying.
# ============================================================================

# --- Core ---
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://nextpik.com
CORS_ORIGIN=https://nextpik.com

# --- Database (also used by docker-compose via ${POSTGRES_*}) ---
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nextpik_production

# --- JWT / Sessions ---
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-me-min-32-chars

# --- Email (Resend) ---
RESEND_API_KEY=change-me
EMAIL_FROM=noreply@nextpik.com
EMAIL_FROM_NAME=NextPik

# --- Google OAuth ---
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=https://api.nextpik.com/api/v1/auth/google/callback

# --- Stripe ---
STRIPE_SECRET_KEY=change-me
STRIPE_PUBLISHABLE_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me
STRIPE_CONNECT_WEBHOOK_SECRET=change-me

# --- PayPal (optional) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Meilisearch (also used by docker-compose via ${MEILISEARCH_API_KEY}) ---
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=change-me

# --- File Storage (Supabase) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_NAME=uploads

# --- Encryption (Gelato credentials at rest) ---
ENCRYPTION_KEY=change-me

# --- Gelato POD (optional, per-seller model) ---
GELATO_API_URL=https://order.gelatoapis.com/v4
GELATO_API_KEY=
GELATO_STORE_ID=
GELATO_WEBHOOK_SECRET=
GELATO_TEST_MODE=false

# --- EasyPost Shipping (optional) ---
EASYPOST_API_KEY=
EASYPOST_TEST_MODE=true
EASYPOST_WEBHOOK_SECRET=

# --- SendCloud Shipping (optional) ---
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_WEBHOOK_SECRET=

# --- EasyShip Shipping (optional) ---
EASYSHIP_API_KEY=
EASYSHIP_WEBHOOK_SECRET=

# --- DHL Express (optional) ---
DHL_EXPRESS_API_KEY=
DHL_EXPRESS_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_API_ENVIRONMENT=sandbox

# --- Awin Affiliate (optional) ---
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

# --- Monitoring (optional) ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=10
